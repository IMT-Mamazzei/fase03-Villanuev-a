package br.maua.cic303;

import java_cup.runtime.*;

parser code {:
    // Método chamado pelo CUP quando encontra um erro sintático
    public void syntax_error(Symbol cur_token) {
        throw new RuntimeException("Erro Sintático na linha " + cur_token.left + ", coluna " + cur_token.right);
    }

    // Integramos o seu Lexer personalizado ao ecossistema do CUP.
    // Redefinimos o scan() para converter o seu 'Token' para o 'Symbol' que o CUP exige.
    private Lexer lexer;

    public parser(Lexer lexer) {
        super();
        this.lexer = lexer;
    }

    @Override
    public Symbol scan() throws java.lang.Exception {
        Token t = lexer.yylex();
        if (t == null) {
            return new Symbol(sym.EOF);
        }

        // Mapeia cada Tag do seu enum para as IDs numéricas geradas na classe sym pelo CUP
        switch (t.tag) {
            case IF:       return new Symbol(sym.IF, lexer.yyline, lexer.yycolumn, t.lexeme);
            case THEN:     return new Symbol(sym.THEN, lexer.yyline, lexer.yycolumn, t.lexeme);
            case ELSE:     return new Symbol(sym.ELSE, lexer.yyline, lexer.yycolumn, t.lexeme);
            case WHILE:    return new Symbol(sym.WHILE, lexer.yyline, lexer.yycolumn, t.lexeme);
            case ID:       return new Symbol(sym.ID, lexer.yyline, lexer.yycolumn, t.lexeme);
            case NUMBER:   return new Symbol(sym.NUMBER, lexer.yyline, lexer.yycolumn, t.lexeme);
            case ASSIGN:   return new Symbol(sym.ASSIGN, lexer.yyline, lexer.yycolumn, t.lexeme);
            case ADD_OP:   return new Symbol(sym.ADD_OP, lexer.yyline, lexer.yycolumn, t.lexeme);
            case MUL_OP:   return new Symbol(sym.MUL_OP, lexer.yyline, lexer.yycolumn, t.lexeme);
            case REL_OP:   return new Symbol(sym.REL_OP, lexer.yyline, lexer.yycolumn, t.lexeme);
            case LPAREN:   return new Symbol(sym.LPAREN, lexer.yyline, lexer.yycolumn, t.lexeme);
            case RPAREN:   return new Symbol(sym.RPAREN, lexer.yyline, lexer.yycolumn, t.lexeme);
            case LBRACE:   return new Symbol(sym.LBRACE, lexer.yyline, lexer.yycolumn, t.lexeme);
            case RBRACE:   return new Symbol(sym.RBRACE, lexer.yyline, lexer.yycolumn, t.lexeme);
            case SEMI:     return new Symbol(sym.SEMI, lexer.yyline, lexer.yycolumn, t.lexeme);
            case EOF:      return new Symbol(sym.EOF);
            default:       
                // Se cair em ERROR ou qualquer outra coisa estranha, manda um token inválido para estourar o erro sintático
                return new Symbol(sym.error, lexer.yyline, lexer.yycolumn, t.lexeme);
        }
    }
:}

/* ========================================================================= */
/* DECLARAÇÃO DOS TOKENS (TERMINAIS)                                         */
/* ========================================================================= */

terminal IF, THEN, ELSE, WHILE;
terminal ASSIGN, LPAREN, RPAREN, LBRACE, RBRACE, SEMI;
terminal String ID, NUMBER;
terminal String ADD_OP, MUL_OP, REL_OP;

/* ========================================================================= */
/* DECLARAÇÃO DOS NÃO-TERMINAIS (VARIÁVEIS DA GRAMÁTICA)                     */
/* ========================================================================= */

non terminal program, stmt_list, stmt;
non terminal assign_stmt, if_stmt, while_stmt, block_stmt, null_stmt;
non terminal expr;

/* ========================================================================= */
/* PRECEDÊNCIA E ASSOCIATIVIDADE                                             */
/* ========================================================================= */

precedence left REL_OP;
precedence left ADD_OP;
precedence left MUL_OP;

/* ========================================================================= */
/* REGRAS DA GRAMÁTICA                                                       */
/* ========================================================================= */

start with program;

program ::= stmt_list ;

/* Lista de comandos que aceita recursão à esquerda e pode ser vazia */
stmt_list ::= stmt_list stmt
            | /* Vazio */
            ;

stmt ::= assign_stmt
       | if_stmt
       | while_stmt
       | block_stmt
       | null_stmt
       ;

assign_stmt ::= ID ASSIGN expr SEMI ;

if_stmt ::= IF LPAREN expr RPAREN THEN block_stmt
          | IF LPAREN expr RPAREN THEN block_stmt ELSE block_stmt
          ;

while_stmt ::= WHILE LPAREN expr RPAREN block_stmt ;

block_stmt ::= LBRACE stmt_list RBRACE ;

null_stmt ::= SEMI ;

expr ::= expr ADD_OP expr
       | expr MUL_OP expr
       | expr REL_OP expr
       | LPAREN expr RPAREN
       | NUMBER
       | ID
       ;
