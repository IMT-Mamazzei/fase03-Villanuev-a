package br.maua.cic303;

import java_cup.runtime.*;

parser code {:
    // Método chamado pelo CUP quando encontra um erro sintático
    public void syntax_error(Symbol cur_token) {
        // CORREÇÃO: Utilizando a CompilerException que o testador automático espera!
        throw new CompilerException("Erro Sintático na linha " + cur_token.left + ", coluna " + cur_token.right);
    }
:}

/* ========================================================================= */
/* DECLARAÇÃO DOS TOKENS (TERMINAIS)                                         */
/* O CUP usará isso para gerar o sym.java que o seu Lexer precisa            */
/* ========================================================================= */

terminal IF, THEN, ELSE, WHILE;
terminal ASSIGN, LPAREN, RPAREN, LBRACE, RBRACE, SEMI;
terminal String ID, NUMBER;
terminal String ADD_OP, MUL_OP, REL_OP;

/* ========================================================================= */
/* DECLARAÇÃO DOS NÃO-TERMINAIS (VARIÁVEIS DA GRAMÁTICA)                     */
/* ========================================================================= */

non terminal program, stmt_list, stmt;
non terminal assign_stmt, if_stmt, while_stmt, block_stmt, null_stmt;
non terminal expr;

/* ========================================================================= */
/* PRECEDÊNCIA E ASSOCIATIVIDADE                                             */
/* ========================================================================= */

/* O operador mais embaixo tem a MAIOR precedência! */
precedence left REL_OP;
precedence left ADD_OP;
precedence left MUL_OP;

/* ========================================================================= */
/* REGRAS DA GRAMÁTICA                                                       */
/* ========================================================================= */

start with program;

/* Um programa é composto por uma lista de comandos */
program ::= stmt_list ;

/* CORREÇÃO: Lista recursiva que PERMITE ser vazia (Produção Epsilon). 
   Isso resolve o "Teste 05 - Bloco Vazio" e permite arquivos sem código. */
stmt_list ::= stmt_list stmt
            | /* Vazio */
            ;

/* Declaração dos comandos possíveis */
stmt ::= assign_stmt
       | if_stmt
       | while_stmt
       | block_stmt
       | null_stmt
       ;

assign_stmt ::= ID ASSIGN expr SEMI ;

/* IF com e sem o ELSE (Substituindo os colchetes do EBNF) */
if_stmt ::= IF LPAREN expr RPAREN THEN block_stmt
          | IF LPAREN expr RPAREN THEN block_stmt ELSE block_stmt
          ;

while_stmt ::= WHILE LPAREN expr RPAREN block_stmt ;

/* Como a nossa stmt_list agora pode ser vazia, essa regra única já cobre 
   tanto os blocos cheios quanto os blocos vazios { } perfeitamente. */
block_stmt ::= LBRACE stmt_list RBRACE ;

null_stmt ::= SEMI ;

/* Regras de expressões com precedência automática baseada nas diretivas no topo */
expr ::= expr ADD_OP expr
       | expr MUL_OP expr
       | expr REL_OP expr
       | LPAREN expr RPAREN
       | NUMBER
       | ID
       ;
